# 部署环境变量配置示例
# 复制此文件为 deploy.env 并根据实际情况修改配置

# SSH 连接配置（必填）
DEPLOY_HOST=your-server.com
DEPLOY_USER=root
DEPLOY_PORT=22
# SSH 私钥路径（可选，留空则使用默认密钥）
# 注意：这是本地机器上的私钥路径，用于从本地连接到远程服务器
# 常用路径：
#   - ~/.ssh/id_rsa
#   - ~/.ssh/id_ed25519
#   - /path/to/your/private/key
DEPLOY_SSH_KEY=

# 远程服务器配置（必填）
DEPLOY_DIR=/var/www/novel2video
DEPLOY_BRANCH=master

# Git 仓库配置（可选，如果服务器上已有 Git 仓库则不需要）
# 示例：
#   - git@github.com:username/repo.git (SSH，推荐)
#   - https://github.com/username/repo.git (HTTPS，会自动转换为 SSH)
GIT_REPO_URL=
