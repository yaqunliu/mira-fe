# Git-crypt 加密配置
# 如果使用 git-crypt 加密敏感文件，取消下面的注释

# 部署配置文件加密
# deploy.env filter=git-crypt diff=git-crypt
# .env.deploy filter=git-crypt diff=git-crypt
# .env.production filter=git-crypt diff=git-crypt

# Supabase 配置
# 从 supabase status --output json 获取的值
NODE_ENV=dev

# API 配置
# 后端 API 的基础 URL，不包含路径，如：https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# 应用端口（可选，默认 3000）
PORT=3000

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
